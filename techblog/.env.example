# Copy to ".env" (the installer does this for you) and keep it OUTSIDE public_html.
# Never commit the real file.

APP_ENV="production"
APP_DEBUG="false"
# Full site address, no trailing slash. Must start with https:// in production.
APP_URL="https://example.com"
APP_TIMEZONE="Europe/Istanbul"
# Random secret used to hash IP addresses (64 hex characters; the installer generates one).
APP_KEY=""
# Set to "true" only when the site is behind a trusted proxy/CDN that sets X-Forwarded-* headers.
TRUST_PROXY="false"
# File-based HTML cache for public pages.
PAGE_CACHE="true"

DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""

# Firebase web app configuration (Firebase console > Project settings > Your apps).
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""

# The first administrator. This account becomes admin when it signs in with a verified e-mail.
ADMIN_EMAIL=""
